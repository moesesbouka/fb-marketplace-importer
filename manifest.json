{
  "manifest_version": 3,
  "name": "CrazyMoe FB Marketplace Importer",
  "version": "1.3.0",
  "description": "Import Facebook Marketplace listings to Supabase",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://sfheqjnxlkygjfohoybo.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/marketplace/*"],
      "js": ["content-importer.js"],
      "run_at": "document_start"
    }
  ]
}